{
  "name": "proudgeonzer0quizx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node --env-file-if-exists=.local/dev.env --env-file-if-exists=.env server/src/index.js",
    "build": "npm run build -w client",
    "db:local": "node scripts/local-db.js",
    "db:migrate": "node --env-file-if-exists=.local/dev.env --env-file-if-exists=.env database/migrate.js",
    "db:seed": "node --env-file-if-exists=.local/dev.env --env-file-if-exists=.env database/seeds/demo.js",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "test:ui": "node --test tests/browser.smoke.js",
    "db:create-user": "node --env-file-if-exists=.local/dev.env --env-file-if-exists=.env database/create-user.js"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "playwright": "^1.65.1",
    "supertest": "^7.3.2"
  }
}
