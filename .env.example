NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-random-secret
# Set to 1 only behind a single trusted HTTPS reverse proxy.
TRUST_PROXY_HOPS=0
# Only the demo seed command uses these; supply privately, never in client code.
DEMO_HOST_PASSWORD=
DEMO_PLAYER_PASSWORD=
